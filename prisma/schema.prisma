generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id             String          @id @db.Uuid
  email          String          @unique
  firstName      String?
  lastName       String?
  role           UserRole        @default(EMPLOYEE)
  department     String?
  position       String?
  joinDate       DateTime?
  phoneNumber    String?
  profileImage   String?
  nic            String?
  dob            String?
  sequentialId   Int             @default(autoincrement())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendances    Attendance[]
  locations      Location[]      @relation("LocationAdmins")
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  reviewedLeaves LeaveRequest[]  @relation("LeaveReviewer")
  workShifts     WorkShift[]     @relation("EmployeeWorkShifts")
  rosters        Roster[]        @relation("EmployeeRosters")
  notifications  NotificationSubscription[]
  assignedTasks  Task[]          @relation("AssignedTasks")
  createdTasks   Task[]          @relation("CreatedTasks")
  taskMessages   TaskMessage[]
  locationId     String?
  location       Location?       @relation("EmployeeLocation", fields: [locationId], references: [id])
  lateAttendanceTracker LateAttendanceTracker?
  foodOrders     FoodOrder[]     @relation("EmployeeFoodOrders")
  approvedFoodOrders FoodOrder[] @relation("FoodOrderApprover")
  salaryConfig   SalaryConfig?
  payrolls       Payroll[]
  
  // New relations for Department and OT
  departmentId       String?
  assignedDepartment Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managedDepartment  Department? @relation("DepartmentHead")
  otRequests         OTRequest[] @relation("EmployeeOTRequests")
  reviewedOTs        OTRequest[] @relation("OTReviewer")

  // New Request Types
  salaryAdvances     SalaryAdvanceRequest[] @relation("EmployeeSalaryAdvances")
  reviewedAdvances   SalaryAdvanceRequest[] @relation("AdvanceReviewer")
  gatePasses         GatePassRequest[]      @relation("EmployeeGatePasses")
  reviewedGatePasses GatePassRequest[]      @relation("GatePassReviewer")
  shortLeaves        ShortLeaveRequest[]    @relation("EmployeeShortLeaves")
  reviewedShortLeaves ShortLeaveRequest[]   @relation("ShortLeaveReviewer")
  
  // Resignation Status
  isResigned         Boolean         @default(false)
  resignedAt         DateTime?

  // Auto Checkout Schedule Settings
  autoCheckoutEnabled Boolean        @default(false)
  autoCheckoutHours   Float?         @default(8.0)

  // Documents & Policies
  createdDocuments         CompanyDocument[]         @relation("DocumentCreator")
  documentAcknowledgements DocumentAcknowledgement[] @relation("EmployeeDocumentAcknowledgements")

  // Off-Day Requests
  offDayRequests           OffDayRequest[]           @relation("EmployeeOffDays")
  reviewedOffDays          OffDayRequest[]           @relation("OffDayReviewer")
  recommendedOffDays       OffDayRequest[]           @relation("OffDayRecommender")

  // Department Messages
  departmentMessages       DepartmentMessage[]

  // Seafood & Pending Bills
  seafoodOrders            SeafoodOrder[]            @relation("EmployeeSeafoodOrders")
  dispatchedSeafoodOrders  SeafoodOrder[]            @relation("SalesDispatchedOrders")
  pendingBillAccounts      PendingBillAccount[]      @relation("EmployeePendingBills")
  confirmedPendingBills    PendingBillAccount[]      @relation("PendingBillHRConfirmers")
  recordedPayments         PendingBillPayment[]      @relation("SalesPaymentRecorders")

  @@index([role])
  @@index([department])
  @@index([isResigned])
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  SUPER_ADMIN
  SECTIONAL_HEAD
}

model Department {
  id              String              @id @default(uuid())
  name            String              @unique
  description     String?
  headId          String?             @unique @db.Uuid
  head            User?               @relation("DepartmentHead", fields: [headId], references: [id])
  employees       User[]              @relation("DepartmentEmployees")
  messages        DepartmentMessage[]
  offDayRequests  OffDayRequest[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model OTRequest {
  id               String      @id @default(uuid())
  userId           String      @db.Uuid
  user             User        @relation("EmployeeOTRequests", fields: [userId], references: [id])
  date             DateTime
  startTime        String      // HH:MM
  endTime          String      // HH:MM
  totalHours       Float
  reason           String      @db.Text
  status           OTStatus    @default(PENDING)
  reviewerId       String?     @db.Uuid
  reviewer         User?       @relation("OTReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([date])
  @@index([status])
}

enum OTStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Location {
  id          String       @id @default(uuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  radius      Float        @default(50) // Default radius in meters
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  admins      User[]       @relation("LocationAdmins")
  employees   User[]       @relation("EmployeeLocation")
}

model Attendance {
  id              String    @id @default(uuid())
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  locationId      String
  location        Location  @relation(fields: [locationId], references: [id])
  checkInTime     DateTime
  checkOutTime    DateTime?
  checkInLatitude Float
  checkInLongitude Float
  checkOutLatitude Float?
  checkOutLongitude Float?
  status          AttendanceStatus @default(PRESENT)
  notes           String?
  isAutoCheckedOut Boolean         @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([locationId])
  @@index([checkInTime])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  OVERTIME
}

model LeaveType {
  id                String         @id @default(uuid())
  name              String
  description       String?
  color             String?        // For UI display
  defaultAllocation Float?         // Annual quota in days (null = unlimited/as-approved)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
}

model LeaveRequest {
  id               String           @id @default(uuid())
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id])
  leaveTypeId      String
  leaveType        LeaveType        @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  totalDays        Float            // Can be fractional for half-days
  reason           String           @db.Text
  status           LeaveStatus      @default(PENDING)
  reviewerId       String?          @db.Uuid
  reviewer         User?            @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documents        LeaveDocument[]
}

model LeaveBalance {
  id           String    @id @default(uuid())
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  year         Int
  totalDays    Float     // Annual quota
  usedDays     Float     @default(0)
  pendingDays  Float     @default(0) // Days in pending requests
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
}

model LeaveDocument {
  id             String       @id @default(uuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  uploadedAt     DateTime     @default(now())
}

enum LeaveStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  CANCELLED
}

model WorkShift {
  id          String    @id @default(uuid())
  name        String
  description String?
  startTime   String    // Store as HH:MM format
  endTime     String    // Store as HH:MM format
  days        String[]  // Array of days of the week (e.g., ["Monday", "Tuesday"])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employees   User[]    @relation("EmployeeWorkShifts")
  rosters     Roster[]
}

model Roster {
  id          String    @id @default(uuid())
  userId      String    @db.Uuid
  user        User      @relation("EmployeeRosters", fields: [userId], references: [id])
  workShiftId String
  workShift   WorkShift @relation(fields: [workShiftId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  isDaily     Boolean   @default(false)
  customDays  String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NotificationSubscription {
  id           String   @id @default(uuid())
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  p256dh       String
  auth         String
  expirationTime DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id           String   @id @default(uuid())
  title        String
  body         String
  icon         String?
  url          String?
  tag          String?
  userId       String?  @db.Uuid
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model DailyReport {
  id           String   @id @default(uuid())
  date         DateTime
  reportType   String   // "ATTENDANCE", "LEAVE", etc.
  reportData   Json
  generatedAt  DateTime @default(now())
  sentToUsers  Boolean  @default(false)
}

model Task {
  id              String        @id @default(uuid())
  title           String
  description     String        @db.Text
  assignedToId    String        @db.Uuid
  assignedTo      User          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedById    String        @db.Uuid
  assignedBy      User          @relation("CreatedTasks", fields: [assignedById], references: [id])
  startDate       DateTime
  deadline        DateTime
  duration        Int           // Duration in minutes
  status          TaskStatus    @default(ASSIGNED)
  proofImageUrl   String?
  reviewedAt      DateTime?
  rejectionReason String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  taskMessages    TaskMessage[]
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
}

model TaskMessage {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model LateAttendanceTracker {
  id                        String   @id @default(uuid())
  userId                    String   @unique @db.Uuid
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consecutiveLateCount      Int      @default(0)
  lastLateDate              DateTime?
  lastWarningDate           DateTime?
  lastDeductionDate         DateTime?
  warningNotificationSent   Boolean  @default(false)
  deductionNotificationSent Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model FoodOrder {
  id           String          @id @default(uuid())
  userId       String          @db.Uuid
  user         User            @relation("EmployeeFoodOrders", fields: [userId], references: [id])
  date         DateTime        // The day the food is for
  mealType     String          // e.g., "Breakfast", "Lunch", "Dinner", "Breakfast + Lunch", etc.
  location     String?         // The location for which the food is ordered
  status       FoodOrderStatus @default(PENDING)
  approvedById String?         @db.Uuid
  approvedBy   User?           @relation("FoodOrderApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, date, mealType]) // Prevent duplicate orders for same meal on same day
}

enum FoodOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SalaryConfig {
  id            String   @id @default(uuid())
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basicSalary   Float
  offDaysCount  Float    @default(0) // Monthly off days (manual entry for payroll)
  allowances    Float    @default(0)
  otAllowance   Float    @default(0)
  otherAllowances Float  @default(0)
  deductions    Float    @default(0) // General/Total deductions
  salaryAdvance Float    @default(0)
  loanDeduction Float    @default(0)
  pendingBills  Float    @default(0)
  incentive     Float    @default(0)
  epfEmployee   Float    @default(8) // Percentage
  epfEmployer   Float    @default(12) // Percentage
  etfEmployer   Float    @default(3) // Percentage
  bankName      String?
  accountNumber String?
  branchName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payroll {
  id               String   @id @default(uuid())
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  basicSalary      Float
  allowances       Float
  otAllowance      Float    @default(0)
  otherAllowances  Float    @default(0)
  deductions       Float
  salaryAdvance    Float    @default(0)
  loanDeduction    Float    @default(0)
  pendingBills     Float    @default(0)
  attendanceBonus  Float    @default(0)
  offDayPay        Float    @default(0)
  holidayPay       Float    @default(0)
  otPay            Float    @default(0)
  lateDeductions   Float    @default(0)
  incentive        Float    @default(0)
  performanceIncentive Float @default(0)
  epfAmount        Float    // Employee share
  etfAmount        Float    // Employer share
  netSalary        Float
  status           PayrollStatus @default(PENDING)
  paidAt           DateTime?
  paysheetUrl      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month, year])
}

enum PayrollStatus {
  PENDING
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

// --- NEW REQUEST TYPES ---

model SalaryAdvanceRequest {
  id               String               @id @default(uuid())
  userId           String               @db.Uuid
  user             User                 @relation("EmployeeSalaryAdvances", fields: [userId], references: [id], onDelete: Cascade)
  requestDate      DateTime
  amount           Float
  transferDate     DateTime?
  reason           String?              @db.Text
  status           RequestStatus        @default(PENDING)
  reviewerId       String?              @db.Uuid
  reviewer         User?                @relation("AdvanceReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model GatePassRequest {
  id               String               @id @default(uuid())
  userId           String               @db.Uuid
  user             User                 @relation("EmployeeGatePasses", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  timeOut          String               // HH:MM
  expectedTimeIn   String?              // HH:MM
  purpose          String               @db.Text
  status           GatePassStatus       @default(PENDING_SECTIONAL_HEAD)
  reviewerId       String?              @db.Uuid
  reviewer         User?                @relation("GatePassReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?              @db.Text
  returnedAt       DateTime?            // Actual time returned
  checkout         GatePassCheckout?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model GatePassCheckout {
  id            String          @id @default(uuid())
  gatePassId    String          @unique
  gatePass      GatePassRequest @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  actualTimeOut DateTime
}

model ShortLeaveRequest {
  id               String               @id @default(uuid())
  userId           String               @db.Uuid
  user             User                 @relation("EmployeeShortLeaves", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  leaveType        ShortLeaveType       // MORNING or EVENING
  startTime        String?              // HH:MM (Check in or out time depending on type)
  endTime          String?              // HH:MM
  reason           String?              @db.Text
  status           RequestStatus        @default(PENDING)
  reviewerId       String?              @db.Uuid
  reviewer         User?                @relation("ShortLeaveReviewer", fields: [reviewerId], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  requestTo        String               @default("ADMIN") // "DEPT_HEAD" or "ADMIN"
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GatePassStatus {
  PENDING_SECTIONAL_HEAD
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
  NOT_RETURNED
}

enum ShortLeaveType {
  MORNING
  EVENING
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


model TrashRecord {
  id          String   @id @default(uuid())
  tableName   String
  recordId    String
  recordData  Json
  deletedAt   DateTime @default(now())

  @@index([tableName])
  @@index([deletedAt])
}

enum CompanyDocumentCategory {
  HR_POLICY
  CODE_OF_CONDUCT
  ACCOMMODATION_CODE_OF_CONDUCT
  GENERAL
}

model CompanyDocument {
  id             String                  @id @default(uuid())
  title          String
  description    String?                 @db.Text
  category       String                  @default("HR_POLICY")
  customCategory String?
  companyScope   String                  @default("ALL")
  fileUrl        String                  @db.Text
  fileName       String
  fileSize       Int?
  fileType       String?                 @default("application/pdf")
  version        String                  @default("v1.0")
  versionNotes   String?                 @db.Text
  effectiveDate  DateTime                @default(now())
  isActive       Boolean                 @default(true)
  isRequired     Boolean                 @default(true)
  createdById    String?                 @db.Uuid
  createdBy      User?                   @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  acknowledgements DocumentAcknowledgement[]

  @@index([category])
  @@index([isActive])
  @@index([companyScope])
}

model DocumentAcknowledgement {
  id             String          @id @default(uuid())
  documentId     String
  document       CompanyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String          @db.Uuid
  user           User            @relation("EmployeeDocumentAcknowledgements", fields: [userId], references: [id], onDelete: Cascade)
  version        String
  acknowledgedAt DateTime        @default(now())
  ipAddress      String?
  notes          String?

  @@unique([documentId, userId, version])
  @@index([userId])
  @@index([documentId])
}

model DepartmentMessage {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  senderId     String     @db.Uuid
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message      String     @db.Text
  attachments  String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
  @@index([createdAt])
}

model OffDayRequest {
  id              String       @id @default(uuid())
  userId          String       @db.Uuid
  user            User         @relation("EmployeeOffDays", fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  date            DateTime
  reason          String?      @db.Text
  status          OffDayStatus @default(PENDING_SECTIONAL_HEAD)
  reviewerId      String?      @db.Uuid
  reviewer        User?        @relation("OffDayReviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?      @db.Text
  recommendedById String?      @db.Uuid
  recommendedBy   User?        @relation("OffDayRecommender", fields: [recommendedById], references: [id])
  recommendedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([date])
  @@index([status])
}

enum OffDayStatus {
  PENDING_SECTIONAL_HEAD
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

model SeafoodItem {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?            @db.Text
  category    String             @default("Fish")
  unit        String             @default("kg")
  unitPrice   Float
  inStock     Boolean            @default(true)
  imageUrl    String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orderItems  SeafoodOrderItem[]
}

model SeafoodOrder {
  id                   String             @id @default(uuid())
  invoiceNo            String             @unique
  userId               String             @db.Uuid
  user                 User               @relation("EmployeeSeafoodOrders", fields: [userId], references: [id], onDelete: Cascade)
  totalAmount          Float
  status               SeafoodOrderStatus @default(ORDERED)
  isDispatchedBySales  Boolean            @default(false)
  dispatchedAt         DateTime?
  dispatchedById       String?            @db.Uuid
  dispatchedBy         User?              @relation("SalesDispatchedOrders", fields: [dispatchedById], references: [id])
  isReceivedByEmployee Boolean            @default(false)
  receivedAt           DateTime?
  notes                String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  items                SeafoodOrderItem[]
  pendingBillAccount   PendingBillAccount? @relation(fields: [pendingBillAccountId], references: [id])
  pendingBillAccountId String?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum SeafoodOrderStatus {
  ORDERED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model SeafoodOrderItem {
  id        String       @id @default(uuid())
  orderId   String
  order     SeafoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      SeafoodItem  @relation(fields: [itemId], references: [id])
  quantity  Float
  unitPrice Float
  subtotal  Float

  @@index([orderId])
  @@index([itemId])
}

model PendingBillAccount {
  id                         String               @id @default(uuid())
  userId                     String               @db.Uuid
  user                       User                 @relation("EmployeePendingBills", fields: [userId], references: [id], onDelete: Cascade)
  month                      Int
  year                       Int
  totalBilled                Float                @default(0)
  cashPaid                   Float                @default(0)
  outstandingBalance         Float                @default(0)
  isSalaryDeductionConfirmed Boolean              @default(false)
  confirmedDeductionAmount   Float                @default(0)
  salaryDeductionConfirmedAt DateTime?
  confirmedById              String?              @db.Uuid
  confirmedBy                User?                @relation("PendingBillHRConfirmers", fields: [confirmedById], references: [id])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  orders                     SeafoodOrder[]
  payments                   PendingBillPayment[]

  @@unique([userId, month, year])
  @@index([month, year])
}

model PendingBillPayment {
  id           String             @id @default(uuid())
  accountId    String
  account      PendingBillAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount       Float
  paymentType  String             @default("CASH")
  recordedById String?            @db.Uuid
  recordedBy   User?              @relation("SalesPaymentRecorders", fields: [recordedById], references: [id])
  receiptNo    String?
  notes        String?
  paidAt       DateTime           @default(now())

  @@index([accountId])
}

model DepartmentNotice {
  id             String             @id @default(uuid())
  title          String
  description    String             @db.Text
  imageUrl       String?            @db.Text
  departmentId   String?
  departmentName String?
  priority       String             @default("NORMAL")
  authorId       String             @db.Uuid
  authorName     String?
  authorRole     String?
  isActive       Boolean            @default(true)
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  readStatuses   NoticeReadStatus[]

  @@index([departmentId])
  @@index([authorId])
  @@index([createdAt])
}

model NoticeReadStatus {
  id       String           @id @default(uuid())
  noticeId String
  notice   DepartmentNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String           @db.Uuid
  readAt   DateTime         @default(now())

  @@unique([noticeId, userId])
  @@index([userId])
}
